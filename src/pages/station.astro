---
import Layout from '../layouts/Layout.astro';

---

<Layout>
    <div class="flex flex-col text-center items-center mt-15 gap-5">

        <h1 id="stationTitle" class="font-bold md:text-6xl lg:text-6xl text-5xl"/>
        <span id="color_bar" class="invisible h-1 rounded-full md:w-75 lg:w-75 w-55 bg-blue-600 shadow-[0_0_12px_#52BAFF,0_0_12px_#52BAFF]"/>

        <p id="date"/> 

        <div id="info" class="grid grid-cols-3 justify-items-center text-center md:text-3xl lg:text-3xl text-1xl font-bold w-full max-w-7xl h-full mt-15 md:gap-30 lg:gap-30 gap-25">

            <p id="availableBikes"/>
            <p id="renting"/>
            <p id="returning"/>       

        </div>

        <h1 id="data" class="font-bold md:text-5xl lg:text-5xl text-4xl mt-25"> Datos Básicos:</h1>
        <span id="color_bar" class="invisible h-1 rounded-full md:w-75 lg:w-75 w-55 bg-blue-600 shadow-[0_0_12px_#52BAFF,0_0_12px_#52BAFF]"/>

        <div id="basicInfo" class="grid grid-cols-3 justify-items-center text-center md:text-3xl lg:text-3xl text-1xl font-bold w-full max-w-7xl h-full mt-15 md:gap-30 lg:gap-30 gap-25">

            <p id="address"/>
            <p id="capacity"/>
            <p id="is_charging_station"/>    
            <p id="is_virtual_station"/>
            <p id="post_code"/> 

        </div>

        <h1 id="data" class="font-bold md:text-5xl lg:text-5xl text-4xl mt-25"> ¡Consulta su historial!</h1>
        <span id="color_bar" class="invisible h-1 rounded-full md:w-75 lg:w-75 w-55 bg-blue-600 shadow-[0_0_12px_#52BAFF,0_0_12px_#52BAFF]"/>

        <a href="/services" class="block text-white font-bold p-3 bg-black border border-white rounded-4xl transition-all duration-300 hover:scale-105 mt-5"> Historial</a>

        <div id="status" class="flex flex-col gap-5"/>

        <canvas id="stationChart" class="w-full h-full max-w-[65%] mx-auto"/>

    </div>
</Layout>

<script type="module">

import '../scripts/station.js';

</script>