---
import Layout from '../layouts/Layout.astro';

---

<div class="flex flex-col gap-5 items-center text-center w-full">
    <h1 id="title02" class="font-bold text-4xl"> Estaciones con más bicicletas: </h1>
    <span id="color_bar02" class="anim-color-bar h-1 rounded-full md:w-125 lg:w-125 w-65 bg-blue-600 shadow-[0_0_12px_#52BAFF,0_0_12px_#52BAFF]"/>

    <div id="ranking" class="invisible flex flex-col max-w-2xl text-left mx-auto text-2xl gap-2"/>


</div>

<script>

import SplitType from "split-type";
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

    let title02 = new SplitType('#title02');
    
    
    gsap.from(title02.chars, {
        y: '100%',
        stagger: 0.05,
        delay: 0.2,
        duration: 0.5,
        ease: 'power2.out',
        autoAlpha: 0,

        scrollTrigger: {
            trigger: "#title02",
            start: "top 80%",
    }
    });

    gsap.from('#color_bar02', {
        y: '100%',
        delay: 1.5,
        duration: 1.0,
        autoAlpha: 0,
        scrollTrigger: {
            trigger: "#title02",
            start: "top 80%",
    }
    });

    gsap.fromTo('#ranking', { 
        x: '-200%'
        },
        {
        x:0,
        delay: 2.0,
        duration: 2.0,
        ease: 'power2.out',
        autoAlpha: 1,
        clearProps: 'transform',
        scrollTrigger: {
            trigger: "#title02",
            start: "top 80%",
        }
    });

</script>
