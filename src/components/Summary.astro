---
import Layout from '../layouts/Layout.astro';

---

<div class="flex flex-col text-center items-center mt-15 gap-5">

    <h1 class="title font-bold md:text-6xl lg:text-6xl text-5xl" data-trigger="inmediate"> Bikepulse</h1>
    
    <p class="invisible md:text-1xl lg:text-1xl mt-10 text" data-trigger="inmediate"> Un proyecto pensado para ofrecer información sobre el estado de las estaciones de bicicletas de la ciudad de A Coruña.</p>


    <div id="info" class="grid grid-cols-2 justify-items-center text-center md:text-3xl lg:text-3xl text-1xl font-bold w-full max-w-7xl h-full mt-10 md:gap-20 lg:gap-20 gap-15" data-trigger="inmediate">

        <p id="estaciones_totales" class="card"/>
        <p id="estaciones_activas" class="card"/>
        <p id="bicis_totales" class="card"/>
        <p id="huecos_totales" class="card"/>

        <div class="col-span-2 flex justify-center items-center">
           <p id="capacidad_total" class="card"/>
        </div>
        

    </div>

</div>

<script>

import '../scripts/animations.js';

</script>
